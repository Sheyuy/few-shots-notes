# xk_par.c probes, 2026-11-03, local 10-core mac (8 threads max)
# correctness: node counts vs serial xk.c (serial counts include the root node)

$ ./xk_par 3 ... -> NO_3_EXCHANGE nodes=3856       (serial 3857)
$ ./xk_par 4 ... -> NO_4_EXCHANGE nodes=57791      (serial 57792)
$ ./xk_par 5 ... -> NO_5_EXCHANGE nodes=777654     (serial 777655)

# k=6 full range, identical node count, 1 vs 8 threads
$ time ./xk_par 6 2000000000000 0 -1 1
NO_6_EXCHANGE nodes=9540881 seconds=422.1 range=[0,15257)
real 422.1
$ time ./xk_par 6 2000000000000 0 -1 8
NO_6_EXCHANGE nodes=9540881 seconds=72.0 range=[0,15257)
real 72.0                     # 5.86x on 8 threads

